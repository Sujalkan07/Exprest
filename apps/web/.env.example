# Exprest Frontend Environment Variables (apps/web/.env.example)

# ==============================================================================
# 1. BACKEND API ENDPOINT (Required)
# ==============================================================================
# Base URL for the Exprest Fastify API gateway
NEXT_PUBLIC_API_URL=http://localhost:4000

# ==============================================================================
# 2. VECTOR TILES & MAPPING (Required for Map Display)
# ==============================================================================
# MapTiler API key for interactive vector tiles in MapLibre GL
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_api_key

# ==============================================================================
# 3. AUTHENTICATION & USER SESSIONS (Required for Production Auth)
# ==============================================================================
# Supabase project URL and public anonymous key
# NOTE: Only public/publishable keys should ever have the NEXT_PUBLIC_ prefix.
# Never expose service-role keys or backend provider credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
