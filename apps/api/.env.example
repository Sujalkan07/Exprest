# Backend Environment Variables (.env.example)

# Fastify Server Port
PORT=4000
NODE_ENV=development

# Telemetry & Geo Provider Keys
RAILRADAR_API_KEY=your_railradar_api_key
MAPTILER_API_KEY=your_maptiler_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key

# Public App Frontend URL (Used for generating Share Links in production)
PUBLIC_APP_URL=http://localhost:3000

# Infrastructure Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exprest
REDIS_URL=redis://localhost:6379
AUTH_SECRET=dev_secret_change_in_prod
