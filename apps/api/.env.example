# Exprest Backend Environment Variables (apps/api/.env.example)

# ==============================================================================
# 1. CORE SERVER CONFIGURATION (Required)
# ==============================================================================
PORT=4000
NODE_ENV=development

# Frontend application URL (Used for generating share link redirects and primary CORS origin)
PUBLIC_APP_URL=http://localhost:3000

# Optional: Comma-separated list of additional allowed CORS origins in production
# Example: CORS_ALLOWED_ORIGINS=https://exprest.vercel.app,https://exprest.com
CORS_ALLOWED_ORIGINS=

# ==============================================================================
# 2. TELEMETRY & DATA PROVIDERS
# ==============================================================================
# Required: RailRadar API key for live train telemetry, status & schedule lookups
RAILRADAR_API_KEY=your_railradar_api_key

# Optional: ScraperAPI key for proxying upstream requests over HTTPS on cloud platforms
SCRAPER_API_KEY=your_scraperapi_key

# Optional: Weather provider for live ambient meteorological data along train route
# Note: Weather requests are proxied via backend /api/v1/journeys/:id/weather
OPENWEATHER_API_KEY=your_openweather_api_key

# Optional: High-resolution elevation data along route coordinates
# Note: Falls back gracefully to Copernicus DEM COP30 without error if key is unset
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key

# ==============================================================================
# 3. OPTIONAL PERSISTENCE & INFRASTRUCTURE
# ==============================================================================
# PostgreSQL connection string for persistence (optional for Phase 1 local run)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exprest

# Redis connection string for cache acceleration (optional for Phase 1 local run)
REDIS_URL=redis://localhost:6379

# Internal session & authentication secret (optional in development)
AUTH_SECRET=dev_secret_change_in_prod
